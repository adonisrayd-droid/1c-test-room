# Скопируйте в .env и заполните. Файл .env в GitHub не загружать.
# Секрет для сессий: openssl rand -hex 32
SESSION_SECRET=
# Пароль пользователя admin (минимум 8 символов)
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
TZ_NAME=Asia/Almaty
# Папка для базы и видео. Пусто = рядом с кодом. На сервере: /var/lib/mysite
DATA_DIR=
# Лимит видео в МБ. Не больше client_max_body_size в nginx
MAX_VIDEO_MB=95
